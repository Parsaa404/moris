# Moris — Apache security (cPanel / shared hosting)
# Place project root as document root, or merge these rules into public_html/.htaccess

Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Enable HSTS only after HTTPS works:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Block direct web access to sensitive folders and files
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(includes|sql|vendor|deploy|scratch|postman)/ - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule \.(md|sql|env|sh|bat|command)$ - [F,L]
</IfModule>
